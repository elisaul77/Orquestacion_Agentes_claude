{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "findings",
    "files_changed",
    "artifacts",
    "criteria",
    "not_verified",
    "unknowns",
    "subagents"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "APPROVED",
        "NEEDS_REVISION",
        "FAILED",
        "DONE",
        "BLOCKED"
      ]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "file",
          "line",
          "issue",
          "fix"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "issue": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths to produced files (e.g. browser-mode PNGs); [] if none."
    },
    "criteria": {
      "type": "array",
      "description": "Review mode: one entry per acceptance criterion; [] in other modes.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "evidence",
          "proof"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "DERIVED",
              "INFERRED",
              "UNKNOWN"
            ]
          },
          "proof": {
            "type": "string"
          }
        }
      }
    },
    "not_verified": {
      "type": "string",
      "description": "What was skipped or could not be checked, or 'nothing'."
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Open questions hit; [] if none."
    },
    "subagents": {
      "type": "array",
      "description": "Coordinate mode: one entry per spawned sub-agent; [] otherwise.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "task",
          "status",
          "summary"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DONE",
              "BLOCKED",
              "FAILED"
            ]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    }
  }
}
